# Base URL of iam-service (auth, orgs, users, roles, role assignments, service principals, audit).
VITE_IAM_SERVICE_URL=http://localhost:8113

# portal is the platform's single login page - an unauthenticated visit here redirects there.
VITE_PORTAL_URL=http://localhost:5175

# Base URL of notification-service. iam-console talks to it directly for the per-organization
# email / queue provider configuration page; it validates the very same iam-service access token
# as a relying party, so there is no second session involved.
VITE_NOTIFICATION_SERVICE_URL=http://localhost:8104
