VITE_INTAKE_API_BASE_URL=http://localhost:8000/api/v1
# iam-service (for silently refreshing the access token) and portal (the platform's one login
# page - an unauthenticated visitor is redirected there, and it hands a session back here on
# success).
VITE_IAM_SERVICE_URL=http://localhost:8113
VITE_PORTAL_URL=http://localhost:5175

# voice-agent-service: called directly from the browser ONLY for the read-only GET /call-agents
# dropdown population on the JD detail page (src/api/voiceAgentDirect.ts), using the same IAM
# bearer token this app already carries. Every other voice-calling operation (setting a JD's
# call config, triggering a call, listing call history, reading a transcript) goes through this
# app's own backend instead (src/api/voiceAgent.ts), which mediates the call using its own
# machine credential.
VITE_VOICE_AGENT_SERVICE_URL=http://localhost:8004
# voice-agent-console: this app doesn't rebuild any call-agent-config management UI - if none
# exist yet for an org, the JD call-config empty state links out to voice-agent-console instead.
VITE_VOICE_AGENT_CONSOLE_URL=http://localhost:5177
