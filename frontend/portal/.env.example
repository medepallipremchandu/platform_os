# Base URL of iam-service (auth: login, token refresh, logout). This is the only backend
# `portal` talks to directly - it has no business-domain API calls of its own.
VITE_IAM_SERVICE_URL=http://localhost:8113

# Destination apps shown as launcher tiles once a user is authenticated. Each one is also
# treated as an allowed post-login handoff target (i.e. a valid `?return_to=` origin) - a
# relying-party app redirects here with `?return_to=<its own URL>` when it has no valid
# session, and after login `portal` hands the tokens back only to one of these origins,
# never to an arbitrary URL a query param could name.
VITE_IAM_CONSOLE_URL=http://localhost:5174
VITE_TALENTOS_APP_URL=http://localhost:5173
VITE_AGENT_BUILDER_CONSOLE_URL=http://localhost:5176
VITE_VOICE_AGENT_CONSOLE_URL=http://localhost:5177
