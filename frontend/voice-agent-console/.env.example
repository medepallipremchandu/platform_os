# voice-agent-service - the single backend this console manages (providers, call agent configs,
# calls).
VITE_VOICE_AGENT_SERVICE_URL=http://localhost:8004

# iam-service - used directly for two things: (1) silently refreshing the access token without a
# round trip through the portal, and (2) the "visible only to specific people" user picker on the
# Providers/Call Agents forms, which reads GET /organizations/{id}/users - a legitimate
# cross-service read since both services are IAM relying parties on the same bearer token.
VITE_IAM_SERVICE_URL=http://localhost:8113

# portal - the platform's single login page/launcher. An unauthenticated visitor is redirected
# here to log in, and it hands a session back to this app via a URL-fragment token handoff.
VITE_PORTAL_URL=http://localhost:5175
