# --- App ---
APP_NAME=TalentOS Intake & Matching Service
ENV=local
HOST=0.0.0.0
PORT=8000
RELOAD=true
LOG_LEVEL=INFO
LOG_DIR=logs

# --- Security ---
# Sent by clients (including assessment-service) as the X-API-Key header.
API_KEY=change-me-local-dev-key
CORS_ORIGINS=http://localhost:5173

# --- Database (local PostgreSQL) ---
# Create the database first, e.g. in pgAdmin: CREATE DATABASE talentos_intake_matching;
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/talentos_intake_matching

# --- LLM providers ---
LLM_PRIMARY_PROVIDER=claude
LLM_FALLBACK_PROVIDER=azure_openai
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=8192

ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-5

AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=your-chat-deployment-name

# --- Resume upload ---
MAX_RESUME_FILE_SIZE_BYTES=10485760
