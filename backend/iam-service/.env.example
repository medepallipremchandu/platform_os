# --- App ---
APP_NAME=TalentOS IAM Service
ENV=local
HOST=0.0.0.0
PORT=8113
RELOAD=true
LOG_LEVEL=INFO
LOG_DIR=logs

# --- CORS: known frontend origins only (design doc §12) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177

# --- Database ---
# CREATE DATABASE talentos_iam;
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/talentos_iam

# --- JWT / RS256 signing keys ---
# Generate the keypair with: python scripts/generate_signing_key.py
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
# Identifies which key signed a token in the JWKS ("kid"). Bump this (and keep the old public
# key published) when rotating keys so in-flight tokens keep validating until they expire.
JWT_KEY_ID=iam-key-1
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Login lockout policy ---
LOGIN_LOCKOUT_THRESHOLD=10
LOGIN_LOCKOUT_WINDOW_MINUTES=15
LOGIN_LOCKOUT_DURATION_MINUTES=15

# --- Password policy ---
PASSWORD_MIN_LENGTH=12
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# --- Outbound notifications (producer only - notification-service owns the consumer) ---
# Must match notification-service's NOTIFICATIONS_BROKER_URL. Note the "sqla+" scheme prefix.
NOTIFICATIONS_BROKER_URL=sqla+postgresql://postgres:postgres@localhost:5432/talentos_notifications
NOTIFICATIONS_QUEUE_NAME=notifications
NOTIFICATIONS_ENABLED=true

# Base URL of `portal` - invite and password-reset emails link to its /set-password page.
PORTAL_URL=http://localhost:5175

# --- Bootstrap (scripts/bootstrap.py only - seeds the ONE platform administrator) ---
# is_superadmin, no organization membership. Organizations and their admins are created from
# iam-console by this account, so nothing else is seeded.
BOOTSTRAP_ADMIN_EMAIL=admin@talentos-platform.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-local-dev-password
