# --- App ---
APP_NAME=TalentOS Notification Service
ENV=local
HOST=0.0.0.0
PORT=8104
RELOAD=true
LOG_LEVEL=INFO
LOG_DIR=logs

# --- CORS: the provider-configuration API is called from iam-console only ---
CORS_ORIGINS=http://localhost:5174

# --- Database ---
# CREATE DATABASE talentos_notifications;
# Same physical database as NOTIFICATIONS_BROKER_URL below, different URL dialect - see app/config.py.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/talentos_notifications

# --- Celery: the PLATFORM broker (tier-1 ingest) ---
# Postgres via Kombu's SQLAlchemy transport. Note the "sqla+" scheme prefix - Kombu parses it
# itself and it is NOT interchangeable with the "postgresql+psycopg2://" form above.
# Deliberately not tenant-configurable: an organization's own queue is a second hop the
# dispatcher re-publishes onto (see README, "Two-tier queueing").
NOTIFICATIONS_BROKER_URL=sqla+postgresql://postgres:postgres@localhost:5432/talentos_notifications
NOTIFICATIONS_QUEUE_NAME=notifications
NOTIFICATIONS_MAX_RETRIES=3
NOTIFICATIONS_RETRY_BACKOFF_SECONDS=10

# --- Platform-default email provider ---
# Leave SMTP_HOST empty to use the console sink: the fully rendered email (INCLUDING the
# set-password / reset link) is written to the log and EmailLog.status is recorded as
# "logged_no_smtp_configured". That is the intended local-dev posture - it makes the invite and
# forgot-password flows fully exercisable with no SMTP credentials anywhere.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@talentos-platform.com
SMTP_USE_TLS=true
# Set false only for a relay with a self-signed / internal-CA certificate (the connection stays
# encrypted - only the "is this really that server" check is dropped).
SMTP_VERIFY_CERT=true

# --- Provider secret encryption ---
# Fernet key for tenant provider secrets at rest (SMTP passwords, API keys, broker DSNs).
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it makes every already-stored secret undecryptable - they must be re-entered.
PROVIDER_SECRET_KEY=

# --- IAM (this service is a relying party on iam-service's RS256 tokens) ---
IAM_SERVICE_URL=http://localhost:8113
IAM_JWKS_URL=http://localhost:8113/.well-known/jwks.json
IAM_JWKS_CACHE_SECONDS=300
