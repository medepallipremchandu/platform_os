# --- App ---
APP_NAME=TalentOS Intake & Matching Service
ENV=local
HOST=0.0.0.0
PORT=8000
RELOAD=true
LOG_LEVEL=INFO
LOG_DIR=logs

# --- Security ---
CORS_ORIGINS=http://localhost:5173

# --- iam-service: this service is a Bearer-token relying party (app/core/iam_client.py) ---
# JWTs are validated locally against IAM_SERVICE_URL's published JWKS - no synchronous call
# to iam-service on the request path. Audit events are also posted here.
IAM_SERVICE_URL=http://localhost:8113
IAM_JWKS_CACHE_TTL_SECONDS=300

# One-time value used only by scripts/backfill_organization_id.py to stamp pre-IAM-migration
# rows. Not read anywhere else - every row created after the migration gets organization_id
# from the caller's verified token.
BOOTSTRAP_ORGANIZATION_ID=

# --- Database (local PostgreSQL) ---
# Create the database first, e.g. in pgAdmin: CREATE DATABASE talentos_app;
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/talentos_app

# --- agent-builder-service ---
# Every AI call (JD analysis, resume analysis, matching, question generation, descriptive
# grading) goes through an agent published in agent-builder-service - there is no
# model/provider/prompt code in this service. Each agent's invoke credential is an IAM-issued,
# resource-bound Service Principal (client_id/client_secret), exchanged for a short-lived
# access token via iam-service's POST /auth/token instead of a static X-Agent-Key header.
#
# These 14 values are REPLACE_ME placeholders until agent-builder-service's own IAM migration
# re-issues each of the 7 agents' invoke credentials as Service Principals and publishes the
# real client_id/client_secret pairs - see that migration's output for the real values.
AGENT_BUILDER_SERVICE_URL=http://localhost:8102/api/v1
AGENT_INVOKE_TIMEOUT_SECONDS=90

JD_ANALYSIS_AGENT_CLIENT_ID=REPLACE_ME_CLIENT_ID
JD_ANALYSIS_AGENT_CLIENT_SECRET=REPLACE_ME_CLIENT_SECRET
RESUME_ANALYSIS_AGENT_CLIENT_ID=REPLACE_ME_CLIENT_ID
RESUME_ANALYSIS_AGENT_CLIENT_SECRET=REPLACE_ME_CLIENT_SECRET
MATCHING_AGENT_CLIENT_ID=REPLACE_ME_CLIENT_ID
MATCHING_AGENT_CLIENT_SECRET=REPLACE_ME_CLIENT_SECRET
QUESTION_GEN_DESCRIPTIVE_AGENT_CLIENT_ID=REPLACE_ME_CLIENT_ID
QUESTION_GEN_DESCRIPTIVE_AGENT_CLIENT_SECRET=REPLACE_ME_CLIENT_SECRET
QUESTION_GEN_MCQ_AGENT_CLIENT_ID=REPLACE_ME_CLIENT_ID
QUESTION_GEN_MCQ_AGENT_CLIENT_SECRET=REPLACE_ME_CLIENT_SECRET
QUESTION_GEN_CODING_AGENT_CLIENT_ID=REPLACE_ME_CLIENT_ID
QUESTION_GEN_CODING_AGENT_CLIENT_SECRET=REPLACE_ME_CLIENT_SECRET
EVALUATION_DESCRIPTIVE_AGENT_CLIENT_ID=REPLACE_ME_CLIENT_ID
EVALUATION_DESCRIPTIVE_AGENT_CLIENT_SECRET=REPLACE_ME_CLIENT_SECRET

# --- Resume upload ---
MAX_RESUME_FILE_SIZE_BYTES=10485760

# --- Code execution sandbox (CODING question evaluation) ---
CODE_EXECUTION_TIMEOUT_SECONDS=5.0
CODE_EXECUTION_MAX_OUTPUT_CHARS=4000

# --- voice-agent-service: AI outbound phone screens ---
# Same machine-to-machine pattern as agent-builder-service above: this service exchanges its own
# IAM-issued Service Principal credential for a bearer token via iam-service's POST /auth/token
# (app/services/voice_agent_client.py) - the recruiter's own browser token never talks to
# voice-agent-service except for the one read-only GET /call-agents dropdown population, which
# the frontend calls directly.
VOICE_AGENT_SERVICE_URL=http://localhost:8004

# REPLACE_ME placeholders until scripts/bootstrap_voice_agent_identity.py is run against a real
# iam-service - it creates a Service Principal, assigns it the built-in "Voice Agent Contributor"
# role, and prints the real client_id/client_secret to put here.
VOICE_AGENT_CLIENT_ID=REPLACE_ME_CLIENT_ID
VOICE_AGENT_CLIENT_SECRET=REPLACE_ME_CLIENT_SECRET

# Random shared secret this service generates once (e.g. `python -c "import secrets;
# print(secrets.token_urlsafe(32))"`) and embeds as a query param in the webhook_url it hands to
# voice-agent-service at call-creation time. Our /webhooks/voice-agent/{submission_call_id}
# receiver checks this matches before trusting an inbound POST - see its README section for why
# that query param is the entire security model on that route (it isn't an IAM bearer-token
# caller).
VOICE_AGENT_WEBHOOK_SECRET=REPLACE_ME_RANDOM_SECRET

# This service's own publicly-reachable base URL, used only to build the webhook_url above.
# Local dev without a tunnel (ngrok etc.) means voice-agent-service can never actually reach this
# path back - matching voice-agent-service's own Twilio-tunnel caveat - but triggering a call and
# polling GET /calls/{id} for its status still work fine without one.
PUBLIC_BASE_URL=http://localhost:8000

# --- one-time use: scripts/bootstrap_voice_agent_identity.py only (never read on the request
# path) - the bootstrap admin iam-service itself was seeded with. ---
IAM_BOOTSTRAP_ADMIN_EMAIL=admin@talentos-platform.com
IAM_BOOTSTRAP_ADMIN_PASSWORD=change-me-local-dev-password
