# --- App ---
APP_NAME=TalentOS Agent Builder Service
ENV=local
HOST=0.0.0.0
PORT=8102
RELOAD=true
LOG_LEVEL=INFO
LOG_DIR=logs

# --- Security ---
CORS_ORIGINS=http://localhost:5176

# Fernet key used to encrypt model provider credentials at rest. Generate your own with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=vJb9YV8kQmT3Zr1cH0sXwF6nE4pL2aG7uD5oI9tK3yQ=

# --- Database ---
# CREATE DATABASE talentos_agent_builder;
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/talentos_agent_builder

# --- Defaults for newly created agents (each agent can override at creation) ---
DEFAULT_TIMEOUT_SECONDS=60
DEFAULT_MAX_OUTPUT_TOKENS=8192
DEFAULT_RATE_LIMIT_PER_MINUTE=60

# --- IAM integration ---
# This service is a relying party on iam-service's RS256-signed access tokens (validated
# locally against its published JWKS - see app/core/iam_client.py).
IAM_SERVICE_URL=http://localhost:8113
IAM_JWKS_CACHE_TTL_SECONDS=300

# This service's own machine identity in iam-service - used only to call
# service-principal-management endpoints when publishing/rotating an agent's invoke
# credential. Run scripts/bootstrap_iam_identity.py to mint these.
IAM_CLIENT_ID=
IAM_CLIENT_SECRET=

# --- Bootstrap-only ---
# scripts/bootstrap_iam_identity.py: the org's admin account, used once to create this
# service's own machine identity in iam-service.
IAM_BOOTSTRAP_ADMIN_EMAIL=admin@talentos-platform.com
IAM_BOOTSTRAP_ADMIN_PASSWORD=change-me-local-dev-password
# scripts/backfill_organization_id.py: the organization every pre-existing model/agent row
# is backfilled into.
BOOTSTRAP_ORGANIZATION_ID=
