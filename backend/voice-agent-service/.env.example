# --- App ---
APP_NAME=TalentOS Voice Agent Service
ENV=local
HOST=0.0.0.0
PORT=8004
RELOAD=true
LOG_LEVEL=INFO

CORS_ORIGINS=http://localhost:5177

# --- Database ---
# CREATE DATABASE talentos_voice_agent;
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/talentos_voice_agent

# --- Public URL / Twilio callbacks ---
# Twilio must be able to POST back into this service (voice/status webhooks) over the public
# internet. In local dev, localhost is NOT reachable by Twilio - you need a tunnel, e.g.:
#   ngrok http 8004                              -> BASE_URL=https://<random>.ngrok-free.app
#   cloudflared tunnel --url http://localhost:8004 -> BASE_URL=https://<random>.trycloudflare.com
# Without a real, publicly reachable BASE_URL, a live Twilio call will dial and ring but never
# progress past DIALING - Twilio has nowhere to deliver the <Gather> turn-loop callbacks. This is
# expected in a sandboxed/local-only environment; everything else in this service (providers,
# call-agents, calls CRUD, visibility rules, retry scheduling) works without it.
BASE_URL=http://localhost:8004

# Fernet key used to encrypt telephony provider credentials at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=vJb9YV8kQmT3Zr1cH0sXwF6nE4pL2aG7uD5oI9tK3yQ=

# How often the retry-scheduling background loop polls for due retries.
RETRY_POLL_INTERVAL_SECONDS=60

# --- iam-service (this service is a Bearer-token relying party - see app/core/iam_client.py) ---
IAM_SERVICE_URL=http://localhost:8113
IAM_JWKS_CACHE_TTL_SECONDS=300

# This service's own machine identity (scripts/bootstrap_iam_identity.py fills these in). Used
# only to post system-attributed audit events for the two Twilio webhook routes, which have no
# end-user bearer token of their own.
IAM_CLIENT_ID=
IAM_CLIENT_SECRET=

# --- Bootstrap-only (scripts/bootstrap_iam_identity.py, scripts/seed_call_agents.py) ---
IAM_BOOTSTRAP_ADMIN_EMAIL=admin@talentos-platform.com
IAM_BOOTSTRAP_ADMIN_PASSWORD=change-me-local-dev-password
BOOTSTRAP_ORGANIZATION_ID=

# --- agent-builder-service: conversation generation is 3 published agents, never a direct model
# call from this service (see app/services/conversation_client.py). Fill these in by running
# scripts/seed_call_agents.py against a running agent-builder-service. ---
AGENT_BUILDER_SERVICE_URL=http://localhost:8102/api/v1
AGENT_INVOKE_TIMEOUT_SECONDS=30.0

CONSENT_TURN_AGENT_CLIENT_ID=
CONSENT_TURN_AGENT_CLIENT_SECRET=
MAIN_TURN_AGENT_CLIENT_ID=
MAIN_TURN_AGENT_CLIENT_SECRET=
SUMMARY_AGENT_CLIENT_ID=
SUMMARY_AGENT_CLIENT_SECRET=
