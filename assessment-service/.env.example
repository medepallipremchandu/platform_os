# --- App ---
APP_NAME=TalentOS Assessment Service
ENV=local
HOST=0.0.0.0
PORT=8001
RELOAD=true
LOG_LEVEL=INFO
LOG_DIR=logs

# --- Security ---
# Sent by clients as the X-API-Key header.
API_KEY=change-me-local-dev-key
# Comma-separated list of origins allowed to call this API from a browser (the React dev server).
CORS_ORIGINS=http://localhost:5173

# --- Database (local PostgreSQL via pgAdmin/server) ---
# Update the username/password/db name to match your local Postgres instance.
# Create the database first, e.g. in pgAdmin: CREATE DATABASE talentos_assessment;
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/talentos_assessment

# --- LLM providers ---
# "claude" is primary, "azure_openai" is the automatic fallback if Claude fails.
LLM_PRIMARY_PROVIDER=claude
LLM_FALLBACK_PROVIDER=azure_openai
LLM_TIMEOUT_SECONDS=60
# Raise if generation is truncated mid-JSON for JDs with many skills (watch for a
# "stop_reason: max_tokens" / "finish_reason: length" warning in the logs).
LLM_MAX_OUTPUT_TOKENS=8192

ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-5

AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=your-chat-deployment-name

# --- Code execution sandbox (CODING question evaluation) ---
CODE_EXECUTION_TIMEOUT_SECONDS=5.0
CODE_EXECUTION_MAX_OUTPUT_CHARS=4000

# --- intake-matching-service (service-to-service) ---
# Where this service fetches a submission's skills/rubrics snapshot from when an interview
# session is created. Must match that service's own API_KEY.
INTAKE_MATCHING_SERVICE_URL=http://localhost:8000/api/v1
INTAKE_MATCHING_API_KEY=change-me-local-dev-key
